# Puerto del servidor (en Render/Railway lo define la plataforma)
PORT=4000
# "production" en el servidor real: desactiva el CORS abierto para localhost / IPs locales
NODE_ENV=development

# MongoDB local o Atlas (agregá el nombre de la base antes del "?")
MONGODB_URI=mongodb://127.0.0.1:27017/saku_films

# Texto largo y random: openssl rand -hex 32
JWT_SECRET=

# Login del panel /admin. El hash se genera con: npm run create-admin
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Orígenes extra permitidos por CORS, separados por coma, sin "/" al final
FRONTEND_URL=http://localhost:5173

# (Opcional) Imágenes en Cloudinary: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Si queda vacío, las imágenes se guardan en backend/uploads/
CLOUDINARY_URL=

# (Opcional) Aviso por email de cada consulta
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
