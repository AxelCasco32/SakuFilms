# Puerto donde corre el backend
PORT=4000

# Origen permitido para CORS (tu frontend en desarrollo)
FRONTEND_URL=http://localhost:5173

# --- Base de datos MongoDB ---
# Si tenés MongoDB instalado localmente, dejalo así:
MONGODB_URI=mongodb://127.0.0.1:27017/saku_films
# Si usás MongoDB Atlas (nube, gratis), reemplazá por tu cadena de conexión, algo como:
# MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/saku_films

# Clave secreta para firmar los tokens de login del admin (poné cualquier string largo y random)
JWT_SECRET=cambiar-esto-por-algo-largo-y-random

# --- Login del panel admin ---
ADMIN_USER=admin
# La contraseña NO se guarda en texto plano. Se genera con: npm run create-admin
# Ese comando te va a pedir una contraseña y te va a dar el hash para pegar acá.
ADMIN_PASSWORD_HASH=$2a$10$LgIJ8jLacmMKvQUlkrCfQuN2LxxHccts7LpfknCyuJiLm/MQ1owaG

# --- Envío de email al recibir una consulta de contacto (opcional) ---
# Si dejás esto vacío, las consultas igual se guardan en la base de datos,
# simplemente no se manda el mail de aviso.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
